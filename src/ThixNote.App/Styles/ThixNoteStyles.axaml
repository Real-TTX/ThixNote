<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#DB4C3F" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FCE3DC" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FDF3EE" />
    <SolidColorBrush x:Key="ListBrush" Color="#FFFBF9" />
    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#2B2623" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A7F79" />
    <SolidColorBrush x:Key="LineBrush" Color="#EFE3DD" />

    <StreamGeometry x:Key="IconPlus">M12 5v14M5 12h14</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M11 3a8 8 0 1 0 0 16a8 8 0 0 0 0-16zM21 21l-4.3-4.3</StreamGeometry>
    <StreamGeometry x:Key="IconStar">M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z</StreamGeometry>
    <StreamGeometry x:Key="IconLock">M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2zM7 11V7a5 5 0 0 1 10 0v4</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6</StreamGeometry>
    <StreamGeometry x:Key="IconDownload">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3</StreamGeometry>
    <StreamGeometry x:Key="IconBook">M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z</StreamGeometry>
    <StreamGeometry x:Key="IconArchive">M21 8v13H3V8M1 3h22v5H1zM10 12h4</StreamGeometry>
    <StreamGeometry x:Key="IconNotes">M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8</StreamGeometry>
    <StreamGeometry x:Key="IconSidebar">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM9 3v18</StreamGeometry>
    <StreamGeometry x:Key="IconEye">M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8zM12 9a3 3 0 1 0 0 6a3 3 0 0 0 0-6z</StreamGeometry>
    <StreamGeometry x:Key="IconPencil">M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z</StreamGeometry>
    <StreamGeometry x:Key="IconMore">M3 12a2 2 0 1 0 4 0a2 2 0 1 0-4 0zM10 12a2 2 0 1 0 4 0a2 2 0 1 0-4 0zM17 12a2 2 0 1 0 4 0a2 2 0 1 0-4 0z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M18 6L6 18M6 6l12 12</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z</StreamGeometry>
    <StreamGeometry x:Key="IconOpen">M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M12 18v-6M9 15l3-3 3 3</StreamGeometry>
  </Styles.Resources>

  <!-- Tabs -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="12,0,6,0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="0,6,2,0" />
    <Setter Property="CornerRadius" Value="9,9,0,0" />
    <Setter Property="MaxWidth" Value="220" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PaperBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter">
    <Setter Property="Background" Value="#F7E4DC" />
  </Style>
  <Style Selector="Button.tabclose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Button.tabclose:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button.icononly">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="9" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.icononly:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Inter, Segoe UI, Helvetica Neue, Arial" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <Style Selector="Path.icon">
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stroke" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Path.icon.muted">
    <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="Path.icon.white">
    <Setter Property="Stroke" Value="White" />
  </Style>
  <Style Selector="Path.icon.accent">
    <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Path.icon.filled">
    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Path.icon.filled-ink">
    <Setter Property="Fill" Value="{StaticResource InkBrush}" />
    <Setter Property="Width" Value="15" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C73A2E" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter">
    <Setter Property="Background" Value="#F9E8E1" />
  </Style>

  <Style Selector="ListBox.notes">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="ListBox.notes ListBoxItem">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="ListBox.notes ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ListBox.notes ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter">
    <Setter Property="Background" Value="#F9EFEA" />
  </Style>

  <Style Selector="TextBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TextBox.plain:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.plain:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Margin" Value="12,22,0,6" />
  </Style>
</Styles>
