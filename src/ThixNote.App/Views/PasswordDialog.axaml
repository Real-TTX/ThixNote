<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ThixNote.App.Views.PasswordDialog"
        Title="Kennwort"
        Icon="avares://ThixNote/Assets/thixnote.ico"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
  <StackPanel Margin="28" Spacing="14">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Path Classes="icon accent" Width="22" Height="22" Data="{StaticResource IconLock}" />
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="320" />
    </StackPanel>
    <TextBox x:Name="PasswordBox" Classes="search" PasswordChar="●" Watermark="Kennwort" />
    <TextBox x:Name="RepeatBox" Classes="search" PasswordChar="●" Watermark="Kennwort wiederholen" />
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBrush}" FontSize="12" IsVisible="False" />
    <TextBlock x:Name="HintText" Classes="caption" TextWrapping="Wrap"
               Text="Das Kennwort wird nirgends gespeichert. Geht es verloren, kann die Notiz nicht wiederhergestellt werden." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="ghost" Content="Abbrechen" Click="OnCancelClick" />
      <Button Classes="primary" Content="OK" Click="OnOkClick" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
