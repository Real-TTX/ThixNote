<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
        xmlns:vm="clr-namespace:ThixNote.App.ViewModels"
        x:Class="ThixNote.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding ActiveDocument.TabTitle, StringFormat='{}{0} – ThixNote', FallbackValue='ThixNote'}"
        Icon="avares://ThixNote/Assets/thixnote.ico"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        Background="{StaticResource PaperBrush}">

  <SplitView DisplayMode="{Binding LibraryDisplayMode}"
             IsPaneOpen="{Binding IsLibraryOpen, Mode=TwoWay}"
             OpenPaneLength="{Binding LibraryPaneWidth}"
             CompactPaneLength="0"
             PaneBackground="{StaticResource SidebarBrush}">

    <!-- Library: sidebar (views, folders) and note list -->
    <SplitView.Pane>
      <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Width="236" Padding="14,16" IsVisible="{Binding ShowSidebarColumn}">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="4,0,0,16">
              <Image Source="avares://ThixNote/Assets/logo-small.png" Width="28" Height="28" />
              <TextBlock Text="ThixNote" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Row="1" Classes="primary" HorizontalAlignment="Stretch" Command="{Binding NewNoteCommand}" ToolTip.Tip="Strg+N">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Path Classes="icon white" Data="{StaticResource IconPlus}" />
                <TextBlock Text="Neue Notiz" />
              </StackPanel>
            </Button>

            <TextBox Grid.Row="2" x:Name="SearchBox" Classes="search" Margin="0,12,0,8" Watermark="Suchen  (Strg+F)" Text="{Binding SearchText}" />

            <StackPanel Grid.Row="3">
              <ListBox Classes="nav" ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedView}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavigationItem">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Panel Width="16">
                        <Path Classes="icon muted" Data="{StaticResource IconNotes}" IsVisible="{Binding IsAllNotes}" />
                        <Path Classes="icon muted" Data="{StaticResource IconStar}" IsVisible="{Binding IsFavorites}" />
                      </Panel>
                      <TextBlock Text="{Binding Label}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Classes="section" Text="ORDNER" />
            </StackPanel>

            <ScrollViewer Grid.Row="4">
              <StackPanel>
                <ListBox Classes="nav" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavigationItem">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Path Classes="icon muted" Data="{StaticResource IconFolder}" />
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBox Classes="search" Margin="0,8,0,0" Watermark="+ Neuer Ordner" Text="{Binding NewFolderName}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding CreateFolderCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="5" Spacing="4" Margin="0,10,0,0">
              <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenFileFromDiskCommand}" ToolTip.Tip="Strg+O">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Path Classes="icon muted" Data="{StaticResource IconOpen}" />
                  <TextBlock Text="Datei öffnen …" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenNotesFolderCommand}" ToolTip.Tip="{Binding NotesFolder}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Path Classes="icon muted" Data="{StaticResource IconFolder}" />
                  <TextBlock Text="Notizordner anzeigen" />
                </StackPanel>
              </Button>
              <TextBlock Classes="caption" Margin="10,6,0,0" Text="{Binding VersionText}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource ListBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,1,0">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Margin="22,20,22,12">
              <TextBlock Text="{Binding ListTitle}" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="caption" Text="{Binding ListSubtitle}" Margin="0,2,0,0" />
            </StackPanel>
            <ListBox Grid.Row="1" Classes="notes" ItemsSource="{Binding LibraryItems}" SelectedItem="{Binding SelectedLibraryItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryItemViewModel">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                        <Path Classes="icon muted" Width="13" Height="13" Data="{StaticResource IconLock}" IsVisible="{Binding IsEncrypted}" />
                        <Path Classes="icon accent filled" Width="13" Height="13" Data="{StaticResource IconStar}" IsVisible="{Binding IsFavorite}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding PreviewText}" Classes="caption" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding DateText}" Classes="caption" Opacity="0.8" />
                      <TextBlock Text="{Binding FolderText}" Classes="caption" Opacity="0.8" IsVisible="{Binding HasFolder}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </SplitView.Pane>

    <!-- Editor area: tabs, document, status bar -->
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Tab bar -->
      <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,0,6,0">
          <Button Grid.Column="0" Classes="icononly" VerticalAlignment="Center" Command="{Binding ToggleLibraryCommand}" ToolTip.Tip="Notizen ein-/ausblenden">
            <Path Classes="icon" Data="{StaticResource IconSidebar}" />
          </Button>

          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="4,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
              <ListBox x:Name="TabsList" Classes="tabs" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DocumentViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding FilePath}">
                      <Path Classes="icon accent" Width="12" Height="12" Data="{StaticResource IconLock}" IsVisible="{Binding IsEncrypted}" />
                      <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                      <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
                      <Button Classes="tabclose" Command="{Binding $parent[Window].DataContext.CloseDocumentCommand}" CommandParameter="{Binding}" ToolTip.Tip="Schließen (Strg+W)">
                        <Path Classes="icon" Width="10" Height="10" Data="{StaticResource IconClose}" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Classes="icononly" Margin="2,6,0,0" Command="{Binding NewNoteCommand}" ToolTip.Tip="Neue Notiz (Strg+N)">
                <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconPlus}" />
              </Button>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsVisible="{Binding !ShowEmptyState}">
            <Button Classes="icononly" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="Favorit">
              <Panel>
                <Path Classes="icon" Data="{StaticResource IconStar}" IsVisible="{Binding !IsActiveFavorite}" />
                <Path Classes="icon accent filled" Data="{StaticResource IconStar}" IsVisible="{Binding IsActiveFavorite}" />
              </Panel>
            </Button>
            <Button Classes="icononly" Command="{Binding ActiveDocument.TogglePreviewCommand}" ToolTip.Tip="Vorschau / Bearbeiten (Strg+E)"
                    IsVisible="{Binding ActiveDocument.IsMarkdown, FallbackValue=False}">
              <Panel>
                <Path Classes="icon" Data="{StaticResource IconEye}" IsVisible="{Binding !ActiveDocument.IsPreview, FallbackValue=True}" />
                <Path Classes="icon accent" Data="{StaticResource IconPencil}" IsVisible="{Binding ActiveDocument.IsPreview, FallbackValue=False}" />
              </Panel>
            </Button>
            <Button Classes="icononly" ToolTip.Tip="Kennwortschutz" IsVisible="{Binding !IsCompact}">
              <Path Classes="icon" Data="{StaticResource IconLock}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Mit Kennwort schützen …" Command="{Binding ProtectActiveDocumentCommand}" IsVisible="{Binding !ActiveDocument.IsEncrypted, FallbackValue=False}" />
                  <MenuItem Header="Jetzt sperren" Command="{Binding ActiveDocument.LockCommand}" InputGesture="Ctrl+L" IsVisible="{Binding ActiveDocument.IsEncrypted, FallbackValue=False}" />
                  <MenuItem Header="Kennwortschutz entfernen" Command="{Binding UnprotectActiveDocumentCommand}" IsVisible="{Binding ActiveDocument.IsEncrypted, FallbackValue=False}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="icononly" ToolTip.Tip="Exportieren" IsVisible="{Binding !IsCompact}">
              <Path Classes="icon" Data="{StaticResource IconDownload}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Als Markdown (.md)" Command="{Binding ExportCommand}" CommandParameter="Markdown" />
                  <MenuItem Header="Als HTML (.html)" Command="{Binding ExportCommand}" CommandParameter="Html" />
                  <MenuItem Header="Als Text (.txt)" Command="{Binding ExportCommand}" CommandParameter="PlainText" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="icononly" ToolTip.Tip="Mehr">
              <Path Classes="icon filled-ink" StrokeThickness="0" Data="{StaticResource IconMore}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Speichern" Command="{Binding SaveActiveDocumentCommand}" InputGesture="Ctrl+S" />
                  <MenuItem Header="Kennwortschutz" IsVisible="{Binding IsCompact}">
                    <MenuItem Header="Mit Kennwort schützen …" Command="{Binding ProtectActiveDocumentCommand}" IsVisible="{Binding !ActiveDocument.IsEncrypted, FallbackValue=False}" />
                    <MenuItem Header="Jetzt sperren" Command="{Binding ActiveDocument.LockCommand}" IsVisible="{Binding ActiveDocument.IsEncrypted, FallbackValue=False}" />
                    <MenuItem Header="Kennwortschutz entfernen" Command="{Binding UnprotectActiveDocumentCommand}" IsVisible="{Binding ActiveDocument.IsEncrypted, FallbackValue=False}" />
                  </MenuItem>
                  <MenuItem Header="Exportieren" IsVisible="{Binding IsCompact}">
                    <MenuItem Header="Als Markdown (.md)" Command="{Binding ExportCommand}" CommandParameter="Markdown" />
                    <MenuItem Header="Als HTML (.html)" Command="{Binding ExportCommand}" CommandParameter="Html" />
                    <MenuItem Header="Als Text (.txt)" Command="{Binding ExportCommand}" CommandParameter="PlainText" />
                  </MenuItem>
                  <MenuItem Header="Im Ordner anzeigen" Command="{Binding RevealActiveDocumentCommand}" />
                  <MenuItem Header="Datei öffnen …" Command="{Binding OpenFileFromDiskCommand}" InputGesture="Ctrl+O" />
                  <Separator />
                  <MenuItem Header="In den Papierkorb" Command="{Binding MoveActiveDocumentToTrashCommand}" />
                  <MenuItem Header="Tab schließen" Command="{Binding CloseDocumentCommand}" InputGesture="Ctrl+W" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Empty state -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" IsVisible="{Binding ShowEmptyState}">
        <Image Source="avares://ThixNote/Assets/logo.png" Width="88" Height="88" HorizontalAlignment="Center" />
        <TextBlock Text="Keine Notiz geöffnet" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Classes="primary" Content="Neue Notiz" Command="{Binding NewNoteCommand}" ToolTip.Tip="Strg+N" />
          <Button Classes="ghost" Content="Datei öffnen …" Command="{Binding OpenFileFromDiskCommand}" ToolTip.Tip="Strg+O" />
        </StackPanel>
      </StackPanel>

      <!-- Locked note: password prompt -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Width="320"
                  IsVisible="{Binding ActiveDocument.IsLocked, FallbackValue=False}">
        <Path Classes="icon accent" Width="40" Height="40" Data="{StaticResource IconLock}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding ActiveDocument.TabTitle}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="Diese Notiz ist mit einem Kennwort geschützt." Classes="caption" FontSize="14" HorizontalAlignment="Center" />
        <TextBox x:Name="UnlockBox" Classes="search" PasswordChar="●" Watermark="Kennwort" Text="{Binding ActiveDocument.UnlockPassword}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ActiveDocument.UnlockCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock Text="{Binding ActiveDocument.UnlockError}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" />
        <Button Classes="primary" HorizontalAlignment="Stretch" Command="{Binding ActiveDocument.UnlockCommand}" IsEnabled="{Binding !ActiveDocument.IsBusy}">
          <Panel>
            <TextBlock Text="Entsperren" IsVisible="{Binding !ActiveDocument.IsBusy}" />
            <TextBlock Text="Wird entschlüsselt …" IsVisible="{Binding ActiveDocument.IsBusy}" />
          </Panel>
        </Button>
      </StackPanel>

      <!-- Document -->
      <ScrollViewer Grid.Row="1" x:Name="DocumentScroller" IsVisible="{Binding ActiveDocument.ShowEditor, FallbackValue=False}">
        <StackPanel Margin="{Binding IsCompact, Converter={x:Static vm:Converters.EditorMargin}}" MaxWidth="860" Spacing="6">
          <TextBox x:Name="TitleEditor" Classes="plain" Text="{Binding ActiveDocument.Title}" Watermark="Titel"
                   FontSize="{Binding IsCompact, Converter={x:Static vm:Converters.TitleFontSize}}" FontWeight="Bold" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <TextBlock Classes="caption" Text="{Binding ActiveDocument.FolderName}" Margin="0,0,10,0" />
            <TextBlock Classes="caption" Text="{Binding ActiveDocument.KindText}" Margin="0,0,10,0" />
            <TextBlock Classes="caption" Text="{Binding ActiveDocument.WordCountText}" />
          </WrapPanel>
          <WrapPanel Orientation="Horizontal" Margin="-8,6,0,4" IsVisible="{Binding ActiveDocument.ShowMarkdownToolbar, FallbackValue=False}">
            <Button Classes="ghost" Click="OnHeadingClick" Content="H1" FontWeight="Bold" ToolTip.Tip="Überschrift" />
            <Button Classes="ghost" Click="OnBoldClick" Content="B" FontWeight="Bold" ToolTip.Tip="Fett (Strg+B)" />
            <Button Classes="ghost" Click="OnItalicClick" Content="I" FontStyle="Italic" ToolTip.Tip="Kursiv (Strg+I)" />
            <Button Classes="ghost" Click="OnQuoteClick" Content="❝" ToolTip.Tip="Zitat" />
            <Button Classes="ghost" Click="OnListClick" Content="•" ToolTip.Tip="Liste" />
            <Button Classes="ghost" Click="OnCheckboxClick" Content="☐" ToolTip.Tip="Aufgabe" />
            <Button Classes="ghost" Click="OnLinkClick" Content="Link" ToolTip.Tip="Link" />
          </WrapPanel>
          <TextBox x:Name="BodyEditor" Classes="plain" Text="{Binding ActiveDocument.Text}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                   FontSize="16" MinHeight="360" Watermark="Einfach losschreiben …" Margin="0,6,0,0"
                   IsVisible="{Binding ActiveDocument.ShowTextEditor, FallbackValue=False}" />
          <md:MarkdownScrollViewer Markdown="{Binding ActiveDocument.Text}" MinHeight="360" Margin="0,6,0,0"
                                   IsVisible="{Binding ActiveDocument.ShowPreview, FallbackValue=False}" />
        </StackPanel>
      </ScrollViewer>

      <!-- Status bar -->
      <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,7" IsVisible="{Binding !ShowEmptyState}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ActiveDocument.StatusText}" Classes="caption" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding ActiveDocument.FilePath}" Classes="caption" TextTrimming="CharacterEllipsis" MaxWidth="420"
                     IsVisible="{Binding !IsCompact}" />
        </Grid>
      </Border>
    </Grid>
  </SplitView>
</Window>
