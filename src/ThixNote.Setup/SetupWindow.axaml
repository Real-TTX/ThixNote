<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ThixNote.Setup.SetupWindow"
        Title="ThixNote Setup"
        Icon="avares://ThixNote-Setup/Assets/thixnote.ico"
        Width="780" Height="480" CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="White">
  <Border CornerRadius="0" ClipToBounds="True">
    <Grid ColumnDefinitions="280,*">

      <!-- Brand panel -->
      <Border Grid.Column="0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#F27560" Offset="0" />
            <GradientStop Color="#C0352A" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid RowDefinitions="*,Auto" Margin="32">
          <StackPanel VerticalAlignment="Center" Spacing="16">
            <Image Source="avares://ThixNote-Setup/Assets/logo.png" Width="120" Height="120" HorizontalAlignment="Left" />
            <TextBlock Text="ThixNote" FontSize="34" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Schnell notieren.&#10;Nichts weiter." FontSize="16" Foreground="#FFEDE7" LineHeight="24" />
          </StackPanel>
          <TextBlock Grid.Row="1" x:Name="VersionText" Foreground="#FFD9CF" FontSize="12" />
        </Grid>
      </Border>

      <!-- Content -->
      <Grid Grid.Column="1" Margin="44,40,44,32">

        <!-- Page: options -->
        <Grid x:Name="OptionsPage" RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="6">
            <TextBlock x:Name="OptionsTitle" Text="Willkommen" FontSize="26" FontWeight="Bold" Foreground="#2B2623" />
            <TextBlock x:Name="OptionsSubtitle" Text="ThixNote wird nur für dein Benutzerkonto installiert. Administratorrechte sind nicht nötig."
                       TextWrapping="Wrap" Foreground="#8A7F79" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="14" VerticalAlignment="Center" x:Name="OptionsBody">
            <TextBlock Text="Installationsordner" FontWeight="SemiBold" FontSize="13" Foreground="#2B2623" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="PathBox" Classes="field" />
              <Button Grid.Column="1" Classes="ghost" Content="Ändern …" Margin="8,0,0,0" Click="OnBrowseClick" />
            </Grid>
            <CheckBox x:Name="DesktopShortcutBox" Content="Verknüpfung auf dem Desktop erstellen" IsChecked="True" />
            <CheckBox x:Name="AssociationBox" Content="Verschlüsselte Notizen (.txts) mit ThixNote öffnen" IsChecked="True" />
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="ghost" Content="Abbrechen" Click="OnCancelClick" />
            <Button x:Name="ActionButton" Classes="primary" Content="Installieren" Click="OnActionClick" />
          </StackPanel>
        </Grid>

        <!-- Page: progress -->
        <StackPanel x:Name="ProgressPage" VerticalAlignment="Center" Spacing="16" IsVisible="False">
          <TextBlock x:Name="ProgressTitle" Text="Wird installiert …" FontSize="26" FontWeight="Bold" Foreground="#2B2623" />
          <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Height="8" CornerRadius="4" Foreground="#DB4C3F" Background="#FCE3DC" />
          <TextBlock x:Name="ProgressText" Foreground="#8A7F79" />
        </StackPanel>

        <!-- Page: finished -->
        <Grid x:Name="FinishedPage" RowDefinitions="*,Auto" IsVisible="False">
          <StackPanel VerticalAlignment="Center" Spacing="12">
            <TextBlock x:Name="FinishedTitle" Text="Fertig!" FontSize="30" FontWeight="Bold" Foreground="#2B2623" />
            <TextBlock x:Name="FinishedText" TextWrapping="Wrap" Foreground="#8A7F79" />
            <CheckBox x:Name="LaunchBox" Content="ThixNote jetzt starten" IsChecked="True" Margin="0,12,0,0" />
          </StackPanel>
          <Button Grid.Row="1" Classes="primary" Content="Schließen" HorizontalAlignment="Right" Click="OnFinishClick" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
