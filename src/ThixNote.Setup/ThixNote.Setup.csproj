<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ThixNote.Setup</RootNamespace>
    <AssemblyName>ThixNote-Setup</AssemblyName>
    <ApplicationIcon>Assets\thixnote.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Path to the zipped, published app. Set by build/Build-Setup.ps1. -->
    <PayloadPath Condition="'$(PayloadPath)' == ''">$(MSBuildThisFileDirectory)payload\payload.zip</PayloadPath>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="payload.zip" Condition="Exists('$(PayloadPath)')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
  </ItemGroup>
</Project>
