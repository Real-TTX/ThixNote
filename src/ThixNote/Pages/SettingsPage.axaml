<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mat="using:MatDesktop"
             xmlns:controls="using:ThixNote.Controls"
             x:Class="ThixNote.Pages.SettingsPage">
  <!-- Settings in tabs: Allgemein | Cloud | Updates | Erweitert. A switch applies at once (like macOS). -->
  <Border Background="{DynamicResource Mat.Surface}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,22,28,28" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="Einstellungen" Theme="{StaticResource MatText.PageTitle}" />
        <TextBlock x:Name="PolicyNote" Theme="{StaticResource MatText.Muted}" Margin="0,4,0,0" IsVisible="False" TextWrapping="Wrap"
                   Text="Von deiner Organisation festgelegt: was eine Richtlinie bestimmt, ist hier ausgeschaltet." />
        <controls:InfoBar x:Name="PageMessage" Margin="0,14,0,0" />

        <TabControl x:Name="Tabs" Margin="0,12,0,0">
          <!-- ===== General ===== -->
          <TabItem x:Name="GeneralTabItem" Header="Allgemein">
            <StackPanel>
              <mat:MatSettingRow Title="Erscheinungsbild">
                <ComboBox x:Name="ThemeChoice" MinWidth="170" AutomationProperties.Name="Erscheinungsbild">
                  <ComboBoxItem Content="Wie das System" />
                  <ComboBoxItem Content="Hell" />
                  <ComboBoxItem Content="Dunkel" />
                </ComboBox>
              </mat:MatSettingRow>
              <mat:MatSettingRow x:Name="NotesFolderRow" Title="Notizordner" Description="Jede Notiz ist eine Datei in diesem Ordner, Unterordner sind Ordner.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="ChangeFolderButton" Click="OnChangeFolderClick">
                    <controls:IconLabel Icon="folder" Text="Ändern …" />
                  </Button>
                  <Button Click="OnOpenNotesFolderClick">
                    <controls:IconLabel Icon="external" Text="Öffnen" />
                  </Button>
                </StackPanel>
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="NotesFolder" Margin="0" />
              <mat:MatSettingRow x:Name="CompactModeRow" Title="Kompaktansicht" Description="Wie Notepad: Tabs, Formatierung, Text und Statusleiste, ohne Menü">
                <ToggleSwitch x:Name="CompactModeSwitch" OnContent="" OffContent="" AutomationProperties.Name="Kompaktansicht" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Zeilenumbruch" Description="Lange Zeilen brechen am Rand des Editors um (wie in Notepad).">
                <ToggleSwitch x:Name="WordWrapSwitch" OnContent="" OffContent="" AutomationProperties.Name="Zeilenumbruch" />
              </mat:MatSettingRow>
              <mat:MatSettingRow x:Name="ZoomRow" Title="Textgröße im Editor" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="ZoomOutButton" Theme="{StaticResource MatButton.Icon}" Click="OnZoomOutClick" AutomationProperties.Name="Verkleinern">
                    <mat:MatIcon Icon="zoom-out" Size="16" />
                  </Button>
                  <TextBlock x:Name="ZoomText" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center" />
                  <Button x:Name="ZoomInButton" Theme="{StaticResource MatButton.Icon}" Click="OnZoomInClick" AutomationProperties.Name="Vergrößern">
                    <mat:MatIcon Icon="zoom-in" Size="16" />
                  </Button>
                  <Button Click="OnZoomResetClick">
                    <controls:IconLabel Icon="restore" Text="100 %" />
                  </Button>
                </StackPanel>
              </mat:MatSettingRow>
            </StackPanel>
          </TabItem>

          <!-- ===== Cloud ===== -->
          <TabItem x:Name="CloudTabItem" Header="Cloud">
            <StackPanel>
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,0,0,16" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                         Text="Mit MatCloud sind deine Notizen auf allen PCs und Macs gleich: neue Notizen, Änderungen, Umbenennungen und gelöschte Notizen werden abgeglichen. Mit Kennwort geschützte Notizen gehen nur verschlüsselt in die Cloud." />
              <controls:InfoBar x:Name="CloudMessage" />

              <!-- Not connected: in the browser (every account), or with user name and password (a local account of the cloud) -->
              <StackPanel x:Name="CloudSignIn" MaxWidth="460" HorizontalAlignment="Left">
                <mat:MatFormField Label="Adresse der Cloud" controls:FormErrors.Field="ServerUrl" Hint="Die Adresse deiner MatCloud, z. B. https://cloud.example.com">
                  <TextBox x:Name="ServerUrlBox" Watermark="https://" AutomationProperties.Name="Adresse der Cloud" />
                </mat:MatFormField>
                <mat:MatFormField Label="Name dieses Geräts" controls:FormErrors.Field="DeviceName" Hint="So erscheint dieser Computer in der Cloud unter „Geräte“.">
                  <TextBox x:Name="DeviceNameBox" AutomationProperties.Name="Name dieses Geräts" />
                </mat:MatFormField>
                <controls:ActionBar Margin="0,6,0,0">
                  <Button x:Name="BrowserSignInButton" Theme="{StaticResource MatButton.Primary}" Click="OnBrowserSignInClick">
                    <controls:IconLabel Icon="globe" Text="Im Browser anmelden" />
                  </Button>
                </controls:ActionBar>
                <Button x:Name="ShowPasswordSignInButton" Theme="{StaticResource MatButton.Link}" Margin="0,16,0,0" Click="OnShowPasswordSignInClick"
                        Content="Mit Benutzername und Passwort anmelden" />
                <StackPanel x:Name="PasswordSignIn" IsVisible="False" Margin="0,12,0,0">
                  <mat:MatFormField Label="Benutzername" controls:FormErrors.Field="UserName">
                    <TextBox x:Name="UserNameBox" AutomationProperties.Name="Benutzername" />
                  </mat:MatFormField>
                  <mat:MatFormField Label="Passwort" controls:FormErrors.Field="Password" Hint="Wird nur für die Anmeldung gebraucht und nicht gespeichert.">
                    <TextBox x:Name="PasswordBox" PasswordChar="●" AutomationProperties.Name="Passwort" />
                  </mat:MatFormField>
                  <controls:ActionBar Margin="0,6,0,0">
                    <Button x:Name="PasswordSignInButton" Click="OnPasswordSignInClick">
                      <controls:IconLabel Icon="login" Text="Anmelden" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>
              </StackPanel>

              <!-- Waiting for the browser: the code, big -->
              <StackPanel x:Name="CloudCode" IsVisible="False" MaxWidth="560" HorizontalAlignment="Left" Spacing="14">
                <Border Theme="{StaticResource MatCard}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Bestätige diesen Code im Browser:" FontWeight="SemiBold" />
                    <SelectableTextBlock x:Name="LinkCodeText" FontFamily="{DynamicResource Mat.Mono}" FontSize="{DynamicResource Mat.FontSize3xl}"
                                         FontWeight="SemiBold" LetterSpacing="3" Margin="0,4" AutomationProperties.Name="Code" />
                    <TextBlock Theme="{StaticResource MatText.Muted}" TextWrapping="Wrap"
                               Text="Der Browser zeigt die Anmeldeseite deiner Cloud. Melde dich dort an, vergleiche den Code und bestätige ihn – ThixNote verbindet sich dann von selbst." />
                    <SelectableTextBlock x:Name="LinkUrlText" FontSize="{DynamicResource Mat.FontSizeSm}" Foreground="{DynamicResource Mat.TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <TextBlock Text="Warte auf die Bestätigung …" Theme="{StaticResource MatText.Muted}" />
                <controls:ActionBar>
                  <Button Click="OnOpenLinkAgainClick">
                    <controls:IconLabel Icon="external" Text="Browser erneut öffnen" />
                  </Button>
                  <Button x:Name="CancelSignInButton" Click="OnCancelSignInClick">
                    <controls:IconLabel Icon="x" Text="Abbrechen" />
                  </Button>
                </controls:ActionBar>
              </StackPanel>

              <!-- Connected: the state and what can be done -->
              <StackPanel x:Name="CloudConnected" IsVisible="False" Spacing="16">
                <Border Theme="{StaticResource MatCard}" MaxWidth="560" HorizontalAlignment="Left">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Text="Verbunden als" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Column="1" x:Name="CloudAccountText" Margin="0,4" />
                    <TextBlock Grid.Row="1" Text="Cloud" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" x:Name="CloudServerText" Margin="0,4" />
                    <TextBlock Grid.Row="2" Text="Dieses Gerät" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CloudDeviceText" Margin="0,4" />
                    <TextBlock Grid.Row="3" Text="Status" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CloudStateText" Margin="0,4" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Text="Zuletzt synchronisiert" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CloudLastSyncText" Margin="0,4" />
                  </Grid>
                </Border>
                <controls:ActionBar>
                  <Button x:Name="SyncNowButton" Theme="{StaticResource MatButton.Primary}" Click="OnSyncNowClick">
                    <controls:IconLabel Icon="refresh" Text="Jetzt synchronisieren" />
                  </Button>
                  <Button Click="OnOpenCloudClick">
                    <controls:IconLabel Icon="external" Text="Im Browser öffnen" />
                  </Button>
                  <Button x:Name="DisconnectButton" Theme="{StaticResource MatButton.Danger}" controls:ActionBar.Separated="True" Click="OnDisconnectClick">
                    <controls:IconLabel Icon="logout" Text="Abmelden" />
                  </Button>
                </controls:ActionBar>
              </StackPanel>
            </StackPanel>
          </TabItem>

          <!-- ===== Updates ===== -->
          <TabItem x:Name="UpdatesTabItem" Header="Updates">
            <StackPanel>
              <Border Theme="{StaticResource MatCard}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,14">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Text="Installiert" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Column="1" x:Name="InstalledVersionText" Margin="0,4" />
                  <TextBlock Grid.Row="1" Text="Kanal" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ChannelText" Margin="0,4" />
                  <TextBlock Grid.Row="2" Text="Zuletzt geprüft" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LastCheckText" Margin="0,4" />
                </Grid>
              </Border>
              <controls:InfoBar x:Name="UpdateMessage" />
              <ProgressBar x:Name="UpdateProgress" Theme="{StaticResource MatProgress}" IsVisible="False" Maximum="1" Margin="0,0,0,12" MaxWidth="560" HorizontalAlignment="Stretch" />
              <controls:ActionBar Margin="0,0,0,10">
                <Button x:Name="CheckUpdateButton" Click="OnCheckUpdateClick">
                  <controls:IconLabel Icon="refresh" Text="Nach Updates suchen" />
                </Button>
                <Button x:Name="InstallUpdateButton" Theme="{StaticResource MatButton.Primary}" Click="OnInstallUpdateClick" IsVisible="False">
                  <controls:IconLabel Icon="download" Text="Jetzt installieren und neu starten" />
                </Button>
                <Button Click="OnReleasePageClick">
                  <controls:IconLabel Icon="external" Text="Versionen auf GitHub" />
                </Button>
              </controls:ActionBar>
              <mat:MatSettingRow Title="Automatisch nach Updates suchen" Description="Beim Start und alle 6 Stunden, im eigenen Kanal (Release oder Nightly).">
                <ToggleSwitch x:Name="CheckUpdatesSwitch" OnContent="" OffContent="" AutomationProperties.Name="Automatisch nach Updates suchen" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Updates automatisch installieren" BorderThickness="0"
                                 Description="Neue Versionen werden im Hintergrund geladen und installiert, wenn du ThixNote schließt – nie mitten beim Schreiben.">
                <ToggleSwitch x:Name="AutoInstallSwitch" OnContent="" OffContent="" AutomationProperties.Name="Updates automatisch installieren" />
              </mat:MatSettingRow>
            </StackPanel>
          </TabItem>

          <!-- ===== Advanced ===== -->
          <TabItem x:Name="AdvancedTabItem" Header="Erweitert">
            <StackPanel>
              <mat:MatSettingRow Title="Datenordner" x:Name="DataFolderRow">
                <Button Click="OnOpenDataFolderClick">
                  <controls:IconLabel Icon="external" Text="Öffnen" />
                </Button>
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Protokolle" x:Name="LogFolderRow" BorderThickness="0">
                <Button Click="OnOpenLogFolderClick">
                  <controls:IconLabel Icon="external" Text="Öffnen" />
                </Button>
              </mat:MatSettingRow>
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,16,0,0" TextWrapping="Wrap"
                         Text="Administratoren können ThixNote per Richtlinie einschränken (LockConfiguration, DisableCloud, DisableUpdates) – unter Windows in HKLM\SOFTWARE\Policies\ThixNote, unter macOS per Konfigurationsprofil info.schmoldt.thixnote." />
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
