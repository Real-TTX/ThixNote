<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mat="using:MatDesktop"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             xmlns:vm="using:ThixNote.ViewModels"
             xmlns:controls="using:ThixNote.Controls"
             x:Class="ThixNote.Pages.NotesPage"
             x:DataType="vm:NotesViewModel"
             DragDrop.AllowDrop="True">
  <!--
    The notes: the list of the library at the left (cards like the history of ThixClip) and the editor at the right, laid out
    like Notepad: the tabs, ONE formatting bar across the whole width, then nothing but the text, and the status bar below.
    The title of a note is its tab (its file name), never part of the text. In a narrow window (MainWindow.ApplyCompact) the
    tabs move into the title bar and the list opens over the editor.
  -->
  <Grid x:Name="Root" ColumnDefinitions="340,*">

    <!-- ===== The list ===== -->
    <Border x:Name="ListPane" Grid.Column="0" Background="{DynamicResource Mat.Surface}" BorderBrush="{DynamicResource Mat.Border}" BorderThickness="0,0,1,0"
            IsVisible="{Binding IsListOpen}" ZIndex="2">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid Margin="20,18,16,12" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding ListTitle}" Theme="{StaticResource MatText.PageTitle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ListSubtitle}" Theme="{StaticResource MatText.Muted}" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="NewNoteButton" Theme="{StaticResource MatButton.Primary}" VerticalAlignment="Top"
                  Command="{Binding NewNoteCommand}">
            <controls:IconLabel Icon="plus" Text="Neu" />
          </Button>
        </Grid>
        <TextBox Grid.Row="1" x:Name="ListSearch" Theme="{StaticResource MatSearchBox}" Margin="16,0,16,12" Watermark="Notizen durchsuchen"
                 Text="{Binding SearchText}" IsVisible="{Binding IsCompact}" AutomationProperties.Name="Notizen durchsuchen" />
        <ListBox Grid.Row="2" x:Name="NoteList" Theme="{StaticResource MatList}" ItemContainerTheme="{StaticResource MatCardRow}" Padding="16,0,16,8"
                 ItemsSource="{Binding LibraryItems}" SelectedItem="{Binding SelectedLibraryItem}" AutomationProperties.Name="Notizen">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LibraryItemViewModel">
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
                    <mat:MatIcon Icon="lock" Size="14" Foreground="{DynamicResource Mat.TextMuted}" IsVisible="{Binding IsEncrypted}" />
                    <mat:MatIcon Icon="star" Size="14" IsFilled="True" Foreground="{DynamicResource Mat.AccentText}" IsVisible="{Binding IsFavorite}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PreviewText}" Theme="{StaticResource MatText.Muted}" FontSize="{DynamicResource Mat.FontSizeSm}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MetaText}" Theme="{StaticResource MatText.Faint}" FontSize="{DynamicResource Mat.FontSizeXs}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{Binding ListEmptyText}" Theme="{StaticResource MatText.Muted}" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="24,24" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding ShowListEmpty}" />
      </Grid>
    </Border>

    <!-- ===== The editor ===== -->
    <Grid x:Name="EditorColumn" Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource Mat.Surface}">

      <!-- the tabs (in a narrow window they are in the title bar) -->
      <Border x:Name="TabBar" Classes="bar" BorderThickness="0,0,0,1" Padding="8,6" Background="{DynamicResource Mat.Surface2}">
        <Grid ColumnDefinitions="Auto,*">
          <Button x:Name="ListToggle" Theme="{StaticResource MatButton.Icon}" Margin="0,0,6,0" VerticalAlignment="Center"
                  Command="{Binding ToggleListCommand}" AutomationProperties.Name="Notizliste">
            <mat:MatIcon Icon="sidebar" Size="16" />
          </Button>
          <ContentControl Grid.Column="1" x:Name="TabHost" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- the formatting bar: across the whole width, never part of the text -->
      <Border Grid.Row="1" x:Name="FormatBar" Classes="bar" BorderThickness="0,0,0,1" Padding="8,4" IsVisible="{Binding !ShowEmptyState}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button x:Name="CompactListToggle" Classes="format" Theme="{StaticResource MatButton.Ghost}" Command="{Binding ToggleListCommand}"
                    IsVisible="{Binding IsCompact}" AutomationProperties.Name="Notizliste" ToolTip.Tip="Notizliste">
              <mat:MatIcon Icon="sidebar" Size="16" />
            </Button>
            <Rectangle Classes="divider" IsVisible="{Binding IsCompact}" />
            <StackPanel x:Name="FormatGroup" Orientation="Horizontal" Spacing="2" IsEnabled="{Binding ActiveDocument.CanFormat, FallbackValue=False}">
              <Button x:Name="HeadingButton" Classes="format" Theme="{StaticResource MatButton.Ghost}" AutomationProperties.Name="Absatzformat" ToolTip.Tip="Überschrift, Zitat, Code">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <mat:MatIcon Icon="type" Size="16" />
                  <mat:MatIcon Icon="chevron-down" Size="12" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="Überschrift 1" Click="OnHeading1Click" />
                    <MenuItem Header="Überschrift 2" Click="OnHeading2Click" />
                    <MenuItem Header="Überschrift 3" Click="OnHeading3Click" />
                    <Separator />
                    <MenuItem Header="Zitat" Click="OnQuoteClick" />
                    <MenuItem Header="Codeblock" Click="OnCodeBlockClick" />
                    <MenuItem Header="Trennlinie" Click="OnRuleClick" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="BoldButton" Classes="format" Theme="{StaticResource MatButton.Ghost}" Click="OnBoldClick" AutomationProperties.Name="Fett">
                <TextBlock Text="B" FontWeight="Bold" />
              </Button>
              <Button x:Name="ItalicButton" Classes="format" Theme="{StaticResource MatButton.Ghost}" Click="OnItalicClick" AutomationProperties.Name="Kursiv">
                <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" />
              </Button>
              <Button x:Name="StrikeButton" Classes="format" Theme="{StaticResource MatButton.Ghost}" Click="OnStrikeClick" AutomationProperties.Name="Durchgestrichen" ToolTip.Tip="Durchgestrichen">
                <TextBlock Text="S" TextDecorations="Strikethrough" FontWeight="SemiBold" />
              </Button>
              <Rectangle Classes="divider" />
              <Button Classes="format" Theme="{StaticResource MatButton.Ghost}" Click="OnListClick" AutomationProperties.Name="Liste" ToolTip.Tip="Liste">
                <mat:MatIcon Icon="list" Size="16" />
              </Button>
              <Button Classes="format" Theme="{StaticResource MatButton.Ghost}" Click="OnNumberedClick" AutomationProperties.Name="Nummerierte Liste" ToolTip.Tip="Nummerierte Liste">
                <TextBlock Text="1." FontWeight="SemiBold" />
              </Button>
              <Button Classes="format" Theme="{StaticResource MatButton.Ghost}" Click="OnTaskClick" AutomationProperties.Name="Aufgabe" ToolTip.Tip="Aufgabe">
                <mat:MatIcon Icon="list-checks" Size="16" />
              </Button>
              <Rectangle Classes="divider" />
              <Button Classes="format" Theme="{StaticResource MatButton.Ghost}" Click="OnLinkClick" AutomationProperties.Name="Link" ToolTip.Tip="Link">
                <mat:MatIcon Icon="link" Size="16" />
              </Button>
              <Button Classes="format" Theme="{StaticResource MatButton.Ghost}" Click="OnCodeClick" AutomationProperties.Name="Code" ToolTip.Tip="Code">
                <mat:MatIcon Icon="code" Size="16" />
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- what acts on the note -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button x:Name="PreviewButton" Classes="format" Theme="{StaticResource MatButton.Ghost}" Command="{Binding ActiveDocument.TogglePreviewCommand}"
                    IsVisible="{Binding ActiveDocument.IsMarkdown, FallbackValue=False}" AutomationProperties.Name="Vorschau">
              <Panel>
                <controls:IconLabel Icon="eye" Text="Vorschau" IsVisible="{Binding !ActiveDocument.IsPreview, FallbackValue=True}" />
                <controls:IconLabel Icon="edit" Text="Bearbeiten" IsVisible="{Binding ActiveDocument.IsPreview, FallbackValue=False}" />
              </Panel>
            </Button>
            <Button x:Name="FavoriteButton" Classes="format" Theme="{StaticResource MatButton.Ghost}" Command="{Binding ToggleFavoriteCommand}" AutomationProperties.Name="Favorit">
              <mat:MatIcon x:Name="FavoriteIcon" Icon="star" Size="16" />
            </Button>
            <Button x:Name="LockButton" Classes="format" Theme="{StaticResource MatButton.Ghost}" AutomationProperties.Name="Kennwortschutz" ToolTip.Tip="Kennwortschutz">
              <mat:MatIcon Icon="lock" Size="16" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Mit Kennwort schützen …" Command="{Binding ProtectActiveDocumentCommand}" IsVisible="{Binding !ActiveDocument.IsEncrypted, FallbackValue=False}" />
                  <MenuItem x:Name="LockNowItem" Header="Jetzt sperren" Command="{Binding ActiveDocument.LockCommand}" IsVisible="{Binding ActiveDocument.IsEncrypted, FallbackValue=False}" />
                  <MenuItem Header="Kennwortschutz entfernen …" Command="{Binding UnprotectActiveDocumentCommand}" IsVisible="{Binding ActiveDocument.IsEncrypted, FallbackValue=False}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="MoreButton" Classes="format" Theme="{StaticResource MatButton.Ghost}" AutomationProperties.Name="Mehr" ToolTip.Tip="Mehr">
              <mat:MatIcon Icon="more-horizontal" Size="16" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem x:Name="RenameItem" Header="Umbenennen …" Command="{Binding RenameActiveDocumentCommand}" />
                  <MenuItem x:Name="SaveItem" Header="Speichern" Command="{Binding SaveActiveDocumentCommand}" />
                  <MenuItem x:Name="OpenItem" Header="Datei öffnen …" Command="{Binding OpenFileFromDiskCommand}" />
                  <MenuItem Header="Im Ordner anzeigen" Command="{Binding RevealActiveDocumentCommand}" />
                  <MenuItem Header="Exportieren">
                    <MenuItem Header="Als Markdown (.md) …" Command="{Binding ExportCommand}" CommandParameter="Markdown" />
                    <MenuItem Header="Als HTML (.html) …" Command="{Binding ExportCommand}" CommandParameter="Html" />
                    <MenuItem Header="Als Text (.txt) …" Command="{Binding ExportCommand}" CommandParameter="PlainText" />
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Zeilenumbruch" Command="{Binding ToggleWordWrapCommand}">
                    <MenuItem.Icon>
                      <mat:MatIcon Icon="check" Size="14" IsVisible="{Binding WordWrap}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem x:Name="ZoomInItem" Header="Vergrößern" Command="{Binding ZoomInCommand}" />
                  <MenuItem x:Name="ZoomOutItem" Header="Verkleinern" Command="{Binding ZoomOutCommand}" />
                  <MenuItem x:Name="ZoomResetItem" Header="Originalgröße" Command="{Binding ZoomResetCommand}" />
                  <Separator />
                  <MenuItem Header="In den Papierkorb …" Command="{Binding MoveActiveDocumentToTrashCommand}" />
                  <MenuItem x:Name="CloseTabItem" Header="Tab schließen" Command="{Binding CloseDocumentCommand}" />
                  <Separator />
                  <MenuItem x:Name="SettingsItem" Header="Einstellungen …" Click="OnSettingsClick" />
                  <MenuItem Header="Über ThixNote" Click="OnAboutClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- nothing open -->
      <StackPanel Grid.Row="2" x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" IsVisible="{Binding ShowEmptyState}">
        <Image Source="avares://ThixNote/Assets/logo.png" Width="80" Height="80" HorizontalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="Keine Notiz geöffnet" Theme="{StaticResource MatText.SectionTitle}" HorizontalAlignment="Center" />
        <TextBlock Text="Wähle links eine Notiz oder fang eine neue an." Theme="{StaticResource MatText.Muted}" HorizontalAlignment="Center" />
        <controls:ActionBar HorizontalAlignment="Center">
          <Button Theme="{StaticResource MatButton.Primary}" Command="{Binding NewNoteCommand}">
            <controls:IconLabel Icon="plus" Text="Neue Notiz" />
          </Button>
          <Button Command="{Binding OpenFileFromDiskCommand}">
            <controls:IconLabel Icon="folder-open" Text="Datei öffnen …" />
          </Button>
        </controls:ActionBar>
      </StackPanel>

      <!-- a locked note: the password, in the place of the text -->
      <Border Grid.Row="2" x:Name="UnlockCard" Theme="{StaticResource MatCard}" Width="380" Padding="28,24" VerticalAlignment="Center" HorizontalAlignment="Center"
              IsVisible="{Binding ActiveDocument.IsLocked, FallbackValue=False}">
        <StackPanel Spacing="12">
          <mat:MatIcon Icon="lock" Size="32" HorizontalAlignment="Center" Foreground="{DynamicResource Mat.AccentText}" />
          <TextBlock Text="{Binding ActiveDocument.TabTitle}" Theme="{StaticResource MatText.SectionTitle}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="Diese Notiz ist mit einem Kennwort geschützt." Theme="{StaticResource MatText.Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" />
          <TextBox x:Name="UnlockBox" PasswordChar="●" Watermark="Kennwort" Text="{Binding ActiveDocument.UnlockPassword}" AutomationProperties.Name="Kennwort">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ActiveDocument.UnlockCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock Text="{Binding ActiveDocument.UnlockError}" Foreground="{DynamicResource Mat.DangerText}" FontSize="{DynamicResource Mat.FontSizeSm}"
                     TextWrapping="Wrap" HorizontalAlignment="Center" IsVisible="{Binding ActiveDocument.HasUnlockError, FallbackValue=False}" />
          <Button Theme="{StaticResource MatButton.Primary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding ActiveDocument.UnlockCommand}" IsEnabled="{Binding !ActiveDocument.IsBusy}">
            <Panel>
              <controls:IconLabel Icon="key" Text="Entsperren" IsVisible="{Binding !ActiveDocument.IsBusy}" />
              <TextBlock Text="Wird entschlüsselt …" IsVisible="{Binding ActiveDocument.IsBusy}" />
            </Panel>
          </Button>
        </StackPanel>
      </Border>

      <!-- the text, and nothing else -->
      <TextBox Grid.Row="2" x:Name="Editor" Classes="editor" Text="{Binding ActiveDocument.Text}" AcceptsReturn="True" AcceptsTab="True"
               FontSize="{Binding EditorFontSize}" Watermark="Einfach losschreiben …" AutomationProperties.Name="Text der Notiz"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
               IsVisible="{Binding ActiveDocument.ShowTextEditor, FallbackValue=False}" />
      <Border Grid.Row="2" x:Name="PreviewHost" Classes="preview" IsVisible="{Binding ActiveDocument.ShowPreview, FallbackValue=False}">
        <md:MarkdownScrollViewer x:Name="Preview" Markdown="{Binding ActiveDocument.PreviewText}" Margin="28,16,28,24">
          <!-- the preview in the colours of the theme (Markdown.Avalonia has colours of its own) -->
          <md:MarkdownScrollViewer.Styles>
            <Style Selector="ctxt|CTextBlock.Heading1, ctxt|CTextBlock.Heading2, ctxt|CTextBlock.Heading3, ctxt|CTextBlock.Heading4, ctxt|CTextBlock.Heading5, ctxt|CTextBlock.Heading6">
              <Setter Property="Foreground" Value="{DynamicResource Mat.Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style Selector="Grid.Table">
              <Setter Property="Background" Value="{DynamicResource Mat.Surface}" />
            </Style>
            <Style Selector="Border.TableHeader">
              <Setter Property="Background" Value="{DynamicResource Mat.Surface3}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Mat.Border}" />
            </Style>
            <Style Selector="Border.TableRowOdd">
              <Setter Property="Background" Value="{DynamicResource Mat.Surface2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Mat.Border}" />
            </Style>
            <Style Selector="Border.TableRowEven">
              <Setter Property="Background" Value="{DynamicResource Mat.Surface}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Mat.Border}" />
            </Style>
            <Style Selector="Border.Blockquote">
              <Setter Property="BorderBrush" Value="{DynamicResource Mat.Accent}" />
              <Setter Property="Background" Value="{DynamicResource Mat.Surface2}" />
            </Style>
            <Style Selector="Border.CodeBlock">
              <Setter Property="Background" Value="{DynamicResource Mat.Surface2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Mat.Border}" />
            </Style>
            <Style Selector="ctxt|CHyperlink">
              <Setter Property="Foreground" Value="{DynamicResource Mat.AccentText}" />
            </Style>
          </md:MarkdownScrollViewer.Styles>
        </md:MarkdownScrollViewer>
      </Border>

      <!-- the status bar: what Notepad shows -->
      <Border Grid.Row="3" x:Name="StatusBar" Classes="bar status" BorderThickness="0,1,0,0" Padding="16,0" Height="30" Background="{DynamicResource Mat.Surface2}"
              IsVisible="{Binding !ShowEmptyState}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="StatusText" Text="{Binding ActiveDocument.StatusText}" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock x:Name="PositionText" Text="{Binding ActiveDocument.PositionText}" />
            <Rectangle Classes="divider" />
            <TextBlock Text="{Binding ActiveDocument.WordCountText}" />
            <Rectangle Classes="divider" />
            <TextBlock Text="{Binding ActiveDocument.CharacterCountText}" IsVisible="{Binding !IsCompact}" />
            <Rectangle Classes="divider" IsVisible="{Binding !IsCompact}" />
            <TextBlock Text="{Binding ActiveDocument.KindText}" />
            <Rectangle Classes="divider" />
            <TextBlock Text="{Binding ZoomText}" />
            <Rectangle Classes="divider" IsVisible="{Binding !IsCompact}" />
            <TextBlock Text="UTF-8" IsVisible="{Binding !IsCompact}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
