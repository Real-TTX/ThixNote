<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop application for Windows and macOS (Avalonia with MatDesktop): the notes library, the editor with tabs and -
    on Windows - its own setup (same program).
    Windows: published self-contained single-file for win-x64; that ThixNote.exe is its own setup (InstallService).
    macOS:   published self-contained for osx-arm64 / osx-x64 and packed into ThixNote.app (scripts/package-macos.sh).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ThixNote</AssemblyName>
    <RootNamespace>ThixNote</RootNamespace>
    <ApplicationIcon>Assets\thixnote.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>ThixNote</AssemblyTitle>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <!-- Bindings in data templates resolve by reflection (the rows and tabs are plain view models). -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    Windows: one file, which is also the setup (App.RunSetupIfRequested). Trimmed in "partial" mode: only libraries that
    declare themselves trimmable lose what ThixNote never calls; ThixNote's own assemblies stay whole, so reflection
    bindings and the JSON of our own types keep working. The self test of the published program (SelfTest.cs, run by CI)
    proves that the trimmed program works.
  -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DefineConstants>$(DefineConstants);SINGLE_FILE</DefineConstants>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- macOS: the files go into ThixNote.app/Contents/MacOS (scripts/package-macos.sh). -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThixNote.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <!-- The snapshot command (Snapshot.cs) draws the windows without a screen. -->
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="11.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThixNote.Core\ThixNote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\thixnote.ico" />
    <AvaloniaResource Include="Assets\logo.png" />
    <AvaloniaResource Include="Assets\logo-small.png" />
    <!-- The icon of .txts files: written next to the installed program by the setup (InstallService), the file association points to it. -->
    <EmbeddedResource Include="Assets\thixnote-document.ico" LogicalName="thixnote-document.ico" />
  </ItemGroup>

</Project>
